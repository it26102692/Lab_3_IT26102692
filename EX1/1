#include <stdio.h>

 const double GRAVITATIONAL_CONSTANT = 9.80; // g = 9.89 m/s^2
 const double EFFICIENCY_CONSTANT = 0.90; // 90% conversion efficiency
 const double WATER_DENSITY = 1000.0; // 1 cubic meter of water = 1000kg

int main() {
       double height;
       double flow_rate;
       double mass_per_second;
       double work_done;
       double power_watts;
       double power_megawatts;

       printf("Enter the height of the dam (in meters): ");
       scanf("%1f", &height);

       printf("Enter the water flow rate (in cubic meters per second): ");
       scanf("%1f", &flow_rate);

       mass_per_second = flow_rate * WATER_DENSITY;

       work_done = mass_per_second * GRAVITATIONAL_CONSTANT * height;

       power_watts = EFFICIENCY_CONSTANT * work_done;

       power_megawatts = power_watts / 1000000.0;

       printf("Predicted power generated by the hydroelectric dam: %.2f megawatts\n");

       	return 0;
}	
            

